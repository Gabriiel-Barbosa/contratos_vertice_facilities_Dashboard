	partition fCarteira = m
		mode: import
		source =
				let
					Origem = Fonte{[Item="tbl_Contratos",Kind="Table"]}[Data],
					Colunas = Table.SelectColumns(Origem, {"ID contrato", "Valor mensal", "Custo direto estimado", "Valor global", "Vigente", "Margem mensal", "Margem %", "Receita anualizada", "Dias para vencimento", "Faixa vigência", "Sinal margem", "Situação reajuste", "Obrigações vencidas", "Ocorrências 12m", "Ocorrências graves abertas", "Pontos atenção", "Exige plano diretoria", "Sinais atenção", "Ordem atenção"}),
					Tipos = Table.TransformColumnTypes(Colunas, {{"ID contrato", type text}, {"Valor mensal", Int64.Type}, {"Custo direto estimado", Int64.Type}, {"Valor global", Int64.Type}, {"Vigente", Int64.Type}, {"Margem mensal", Int64.Type}, {"Margem %", type number}, {"Receita anualizada", Int64.Type}, {"Dias para vencimento", Int64.Type}, {"Faixa vigência", type text}, {"Sinal margem", type text}, {"Situação reajuste", type text}, {"Obrigações vencidas", Int64.Type}, {"Ocorrências 12m", Int64.Type}, {"Ocorrências graves abertas", Int64.Type}, {"Pontos atenção", Int64.Type}, {"Exige plano diretoria", type text}, {"Sinais atenção", type text}, {"Ordem atenção", Int64.Type}}, "pt-BR"),
					Passo1 = Table.AddColumn(Tipos, "Ordem faixa", each if Text.Contains([Faixa vigência], "até 30") then 1 else if Text.Contains([Faixa vigência], "31 a 60") then 2 else if Text.Contains([Faixa vigência], "61 a 90") then 3 else if Text.Contains([Faixa vigência], "91 a 180") then 4 else if Text.Contains([Faixa vigência], "acima") then 5 else 6, Int64.Type)
				in
					Passo1

	annotation PBI_ResultType = Table
