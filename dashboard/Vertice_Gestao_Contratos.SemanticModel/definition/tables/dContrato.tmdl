	partition dContrato = m
		mode: import
		source =
				let
					Vigentes = Table.SelectColumns(Fonte{[Item="tbl_Contratos",Kind="Table"]}[Data], {"ID contrato", "Cliente ID", "Cliente nome", "Objeto", "Segmento", "Município", "Gestor contrato", "Início vigência", "Fim vigência"}),
					BaseVigentes = Table.AddColumn(Vigentes, "Situação", each "Vigente", type text),
					Encerrados = Table.SelectColumns(Fonte{[Item="tbl_Encerrados",Kind="Table"]}[Data], {"ID encerrado", "Cliente ID", "Cliente nome", "Serviço", "Segmento", "Data início", "Data encerramento"}),
					Renomeados = Table.RenameColumns(Encerrados, {{"ID encerrado", "ID contrato"}, {"Serviço", "Objeto"}, {"Data início", "Início vigência"}, {"Data encerramento", "Fim vigência"}}),
					ComMunicipio = Table.AddColumn(Renomeados, "Município", each "Não informado", type text),
					ComGestor = Table.AddColumn(ComMunicipio, "Gestor contrato", each "Não informado", type text),
					BaseEncerrados = Table.AddColumn(ComGestor, "Situação", each "Encerrado", type text),
					Ocorrencias = Fonte{[Item="tbl_Ocorrencias",Kind="Table"]}[Data],
					IdsOportunidade = List.RemoveNulls(Ocorrencias[ID oportunidade]),
					Oportunidades = Table.SelectRows(Fonte{[Item="tbl_Oportunidades",Kind="Table"]}[Data], each List.Contains(IdsOportunidade, [ID oportunidade])),
					OpSelecao = Table.SelectColumns(Oportunidades, {"ID oportunidade", "Cliente ID", "Cliente nome", "Nome oportunidade", "Segmento", "Município", "Responsável"}),
					OpRenomeada = Table.RenameColumns(OpSelecao, {{"ID oportunidade", "ID contrato"}, {"Nome oportunidade", "Objeto"}, {"Responsável", "Gestor contrato"}}),
					OpInicio = Table.AddColumn(OpRenomeada, "Início vigência", each null, type nullable date),
					OpFim = Table.AddColumn(OpInicio, "Fim vigência", each null, type nullable date),
					BaseOportunidades = Table.AddColumn(OpFim, "Situação", each "Oportunidade", type text),
					Uniao = Table.Combine({BaseVigentes, BaseEncerrados, BaseOportunidades}),
					Tipos = Table.TransformColumnTypes(Uniao, {{"ID contrato", type text}, {"Cliente ID", type text}, {"Cliente nome", type text}, {"Objeto", type text}, {"Segmento", type text}, {"Município", type text}, {"Gestor contrato", type text}, {"Início vigência", type date}, {"Fim vigência", type date}, {"Situação", type text}}, "pt-BR"),
					Rotulo = Table.AddColumn(Tipos, "Contrato", each [ID contrato] & " · " & [Cliente nome], type text)
				in
					Rotulo

	annotation PBI_ResultType = Table

