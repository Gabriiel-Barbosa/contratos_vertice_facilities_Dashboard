	partition fOcorrencias = m
		mode: import
		source =
				let
					Origem = Fonte{[Item="tbl_Ocorrencias",Kind="Table"]}[Data],
					Colunas = Table.SelectColumns(Origem, {"Ocorrência ID", "Tipo registro", "ID contrato", "ID oportunidade", "Data", "Categoria", "Descrição", "Probabilidade", "Impacto", "Responsável", "Plano ação", "Prazo", "Status", "Valor glosa", "Custo extra", "Pontuação", "Severidade", "Aberta", "Prazo vencido"}),
					Tipos = Table.TransformColumnTypes(Colunas, {{"Ocorrência ID", type text}, {"Tipo registro", type text}, {"ID contrato", type text}, {"ID oportunidade", type text}, {"Data", type date}, {"Categoria", type text}, {"Descrição", type text}, {"Probabilidade", type text}, {"Impacto", type text}, {"Responsável", type text}, {"Plano ação", type text}, {"Prazo", type date}, {"Status", type text}, {"Valor glosa", type number}, {"Custo extra", type number}, {"Pontuação", Int64.Type}, {"Severidade", type text}, {"Aberta", Int64.Type}, {"Prazo vencido", type text}}, "pt-BR"),
					Passo1 = Table.ReplaceValue(Tipos, each [ID contrato], each if [ID contrato] = null then [ID oportunidade] else [ID contrato], Replacer.ReplaceValue, {"ID contrato"}),
					Passo2 = Table.AddColumn(Passo1, "Ordem probabilidade", each if [Probabilidade] = "Alta" then 3 else if [Probabilidade] = "Média" then 2 else 1, Int64.Type),
					Passo3 = Table.AddColumn(Passo2, "Ordem impacto", each if [Impacto] = "Alto" then 3 else if [Impacto] = "Médio" then 2 else 1, Int64.Type),
					Passo4 = Table.AddColumn(Passo3, "Ordem severidade", each if [Severidade] = "Crítica" then 4 else if [Severidade] = "Alta" then 3 else if [Severidade] = "Média" then 2 else 1, Int64.Type)
				in
					Passo4

	annotation PBI_ResultType = Table

