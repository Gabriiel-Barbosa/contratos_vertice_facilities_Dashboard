		displayFolder: 8. Financeiro
		lineageTag: e4d9e899-b69d-53a6-b2f1-f1e28408a68c

	measure 'Margem Realizada' = SUM(fFinanceiro[Margem estimada])
		formatString: "\R$ #,0;-\R$ #,0"
		displayFolder: 8. Financeiro
		lineageTag: 4a8e3f03-e86a-58a5-a928-9bd31ea4160e

	measure 'Margem Realizada %' = DIVIDE([Margem Realizada], [Receita Faturada])
		formatString: "0.0%"
		displayFolder: 8. Financeiro
		lineageTag: c36f1370-c2b4-51ba-b3ab-31bad41f721d

	measure 'A Receber' = [Receita Faturada] - [Receita Recebida]
		formatString: "\R$ #,0;-\R$ #,0"
		displayFolder: 8. Financeiro
		lineageTag: 4786dba3-d8fc-5968-8fd1-da92f4d821e2

	measure 'Última Competência' = VAR Ref = [Data Referência] VAR Comp = EDATE(DATE(YEAR(Ref), MONTH(Ref), 1), -1) RETURN CALCULATE(SUM(fFinanceiro[Receita prevista]), fFinanceiro[Competência] = Comp)
		formatString: "\R$ #,0;-\R$ #,0"
		displayFolder: 8. Financeiro
		lineageTag: 302a6c9d-c7c1-55c1-9ae4-de1cfa5555b5

	measure 'Texto Data-base' = "Data-base: " & FORMAT([Data Referência], "dd/mm/yyyy")
		displayFolder: 9. Apresentação
		lineageTag: df9dc236-0adf-56bc-9771-7a949be27189

	measure 'Cor Margem' = IF([Margem %] < [Margem Mínima], "#D96C5F", "#2E8B78")
		displayFolder: 9. Apresentação
		lineageTag: 9344b81e-66e4-5812-868e-c4733af7d5e1

	measure 'Cor Situação Prazo' = SWITCH(SELECTEDVALUE(fObrigacoes[Situação prazo]), "Vencida", "#D96C5F", "Vence em breve", "#E6B85C", "#2E8B78")
		displayFolder: 9. Apresentação
		lineageTag: 814fbda7-c8fb-515c-9fd0-38a0fac119f4

	measure 'Cor Matriz' = VAR P = MAX(fOcorrencias[Ordem probabilidade]) * MAX(fOcorrencias[Ordem impacto]) RETURN IF([Riscos e Ocorrências] > 0, IF(P >= 6, "#D96C5F", IF(P >= 3, "#E6B85C", "#2E8B78")), "#F2F4F5")
		displayFolder: 9. Apresentação
		lineageTag: 373065d0-e904-5bac-ac44-a2e38f6b6a98

	measure 'Cor Severidade' = SWITCH(SELECTEDVALUE(fOcorrencias[Severidade]), "Crítica", "#D96C5F", "Alta", "#D96C5F", "Média", "#E6B85C", "#2E8B78")
		displayFolder: 9. Apresentação
		lineageTag: 1fc2080c-e04c-556f-92cd-3a3686e9d2fc

	measure 'Prevista Mês' = VAR C = EDATE(DATE(YEAR([Data Referência]), MONTH([Data Referência]), 1), -1) RETURN CALCULATE(SUM(fFinanceiro[Receita prevista]), fFinanceiro[Competência] = C)
		formatString: "\R$ #,0;-\R$ #,0"
		displayFolder: 9.1 Comparativos
		lineageTag: 88b96668-4a4f-5fa0-b56c-11f3cac14791

	measure 'Prevista Mês Anterior' = VAR C = EDATE(DATE(YEAR([Data Referência]), MONTH([Data Referência]), 1), -2) RETURN CALCULATE(SUM(fFinanceiro[Receita prevista]), fFinanceiro[Competência] = C)
		formatString: "\R$ #,0;-\R$ #,0"
		displayFolder: 9.1 Comparativos
		lineageTag: 39c8956b-35e3-559a-8b32-141582e9ec2d

	measure 'Prevista 12 Meses Antes' = VAR C = EDATE(DATE(YEAR([Data Referência]), MONTH([Data Referência]), 1), -12) RETURN CALCULATE(SUM(fFinanceiro[Receita prevista]), fFinanceiro[Competência] = C)
		formatString: "\R$ #,0;-\R$ #,0"
		displayFolder: 9.1 Comparativos
		lineageTag: eaa64bfa-0b7d-5cd8-90cb-3633c519d8b0

	measure 'Faturada Mês' = VAR C = EDATE(DATE(YEAR([Data Referência]), MONTH([Data Referência]), 1), -1) RETURN CALCULATE(SUM(fFinanceiro[Receita faturada]), fFinanceiro[Competência] = C)
		formatString: "\R$ #,0;-\R$ #,0"
