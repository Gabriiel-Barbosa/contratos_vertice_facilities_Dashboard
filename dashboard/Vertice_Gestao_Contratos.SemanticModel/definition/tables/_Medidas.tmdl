		displayFolder: 6. Comercial
		lineageTag: b02cf972-5528-52d0-94b4-7e0a9be57539

	/// R$/ano. Não compõe a carteira contratada.
	measure 'Pipeline Nominal' = CALCULATE(SUM(fOportunidades[Valor anual estimado]), fOportunidades[Aberta] = 1)
		formatString: "\R$ #,0;-\R$ #,0"
		displayFolder: 6. Comercial
