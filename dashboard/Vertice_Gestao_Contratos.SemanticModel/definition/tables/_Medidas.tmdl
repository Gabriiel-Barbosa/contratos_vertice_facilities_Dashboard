table _Medidas
	lineageTag: 218fc37d-75e2-524b-a2d3-40b10bddc76a

	measure 'Data Referência' = MAX(Parametros[Data_Referencia])
		formatString: "dd/mm/yyyy"
		displayFolder: 1. Carteira
		lineageTag: 2006142e-91f9-573b-9ade-afa55b3e3c0d

	/// Contratos ativos na data-base.
	measure 'Contratos Vigentes' = SUM(fCarteira[Vigente]) + 0
		formatString: "#,0"
		displayFolder: 1. Carteira
		lineageTag: 92f494a3-3e91-5c55-905d-9ee5bf1b85db

	/// Valor mensal dos contratos vigentes. Não é faturamento.
	measure 'Receita Mensal Contratada' = CALCULATE(SUM(fCarteira[Valor mensal]), fCarteira[Vigente] = 1)
		formatString: "\R$ #,0;-\R$ #,0"
		displayFolder: 1. Carteira
		lineageTag: 66b5097a-bc3b-57ad-abc2-10c38a398139

	measure 'Receita Anualizada' = CALCULATE(SUM(fCarteira[Receita anualizada]), fCarteira[Vigente] = 1)
		formatString: "\R$ #,0;-\R$ #,0"
		displayFolder: 1. Carteira
		lineageTag: 77888f30-a22d-5675-ba19-da989fae9846

	measure 'Custo Direto Mensal' = CALCULATE(SUM(fCarteira[Custo direto estimado]), fCarteira[Vigente] = 1)
		formatString: "\R$ #,0;-\R$ #,0"
		displayFolder: 1. Carteira
		lineageTag: 1786ac70-2e06-5b93-996b-1be89b9f0a9a

	/// Margem de contribuição estimada. Não é lucro.
	measure 'Margem Mensal' = CALCULATE(SUM(fCarteira[Margem mensal]), fCarteira[Vigente] = 1)
		formatString: "\R$ #,0;-\R$ #,0"
		displayFolder: 1. Carteira
		lineageTag: 5601ce0c-593e-59ff-8a42-5c360becaa7f

	measure 'Margem %' = DIVIDE([Margem Mensal], [Receita Mensal Contratada])
		formatString: "0.00%"
		displayFolder: 1. Carteira
		lineageTag: 5be2bd51-154b-5975-b808-00f59deba0d3

	measure 'Clientes Ativos' = COUNTROWS(FILTER(VALUES(dCliente[Cliente ID]), [Receita Mensal Contratada] > 0)) + 0
		formatString: "#,0"
		displayFolder: 1. Carteira
		lineageTag: 6dd5c765-e56c-5ca6-a9f6-7afb19ec77db

	measure 'Receita Top 5 Clientes' = SUMX(TOPN(5, VALUES(dCliente[Cliente ID]), [Receita Mensal Contratada], DESC), [Receita Mensal Contratada])
		formatString: "\R$ #,0;-\R$ #,0"
		displayFolder: 1. Carteira
		lineageTag: d8eac5d7-c75a-51c5-8937-f5e23af34a9c

	measure 'Participação Top 5' = DIVIDE([Receita Top 5 Clientes], [Receita Mensal Contratada])
		formatString: "0.00%"
		displayFolder: 1. Carteira
		lineageTag: 90572d3c-dc65-5868-8c28-69525c30a46e

	measure 'Participação no Total' = DIVIDE([Receita Mensal Contratada], CALCULATE([Receita Mensal Contratada], ALL(dCliente), ALL(dContrato), ALL(dSegmento)))
		formatString: "0.0%"
		displayFolder: 1. Carteira
		lineageTag: 6475f902-f5a4-52a2-a210-32e8e5bbfbdf

	measure 'Contratos Abaixo da Margem' = CALCULATE(COUNTROWS(fCarteira), fCarteira[Vigente] = 1, fCarteira[Sinal margem] <> "Dentro do limite") + 0
		formatString: "#,0"
		displayFolder: 1. Carteira
		lineageTag: c27e5671-11b5-55c9-8d65-5c9e862c50b1

	measure 'Contratos com Plano' = CALCULATE(COUNTROWS(fCarteira), fCarteira[Exige plano diretoria] = "Sim") + 0
		formatString: "#,0"
		displayFolder: 1. Carteira
		lineageTag: cf1291e8-3352-575a-8d2b-4efc4f3d913f

	measure 'Segmento Líder' = MAXX(TOPN(1, VALUES(dSegmento[Segmento]), [Receita Mensal Contratada], DESC), dSegmento[Segmento])
		displayFolder: 1. Carteira
		lineageTag: 40c33b52-2605-57ec-8246-1d3c12c18df4

	measure 'Margem Mínima' = MAX(Parametros[Margem_Minima])
		formatString: "0%"
		displayFolder: 1. Carteira
		lineageTag: 05e2e655-1cca-5eb2-b9a7-5cb4efa64e8d

	measure 'Receita Maiores Clientes' = IF(RANKX(ALLSELECTED(dCliente[Nome fantasia]), [Receita Mensal Contratada],, DESC) <= 5, [Receita Mensal Contratada])
		formatString: "\R$ #,0;-\R$ #,0"
		displayFolder: 1. Carteira
		lineageTag: b184af1f-a706-5353-a35f-c3a4f93eda2a

	measure 'Vencem em 30 Dias' = CALCULATE(COUNTROWS(fCarteira), fCarteira[Vigente] = 1, fCarteira[Dias para vencimento] >= 0, fCarteira[Dias para vencimento] <= 30) + 0
		formatString: "#,0"
		displayFolder: 2. Vigência
		lineageTag: d97deb10-c476-52c8-a162-b56cce5ebd84

	measure 'Vencem em 60 Dias' = CALCULATE(COUNTROWS(fCarteira), fCarteira[Vigente] = 1, fCarteira[Dias para vencimento] >= 0, fCarteira[Dias para vencimento] <= 60) + 0
		formatString: "#,0"
		displayFolder: 2. Vigência
		lineageTag: 7201def7-8018-5edb-94da-e48608e70e77

	measure 'Vencem em 90 Dias' = CALCULATE(COUNTROWS(fCarteira), fCarteira[Vigente] = 1, fCarteira[Dias para vencimento] >= 0, fCarteira[Dias para vencimento] <= 90) + 0
		formatString: "#,0"
		displayFolder: 2. Vigência
		lineageTag: 3f0a46da-aff7-5531-b370-e05bb5bab266

	measure 'Vencem em 180 Dias' = CALCULATE(COUNTROWS(fCarteira), fCarteira[Vigente] = 1, fCarteira[Dias para vencimento] >= 0, fCarteira[Dias para vencimento] <= 180) + 0
		formatString: "#,0"
		displayFolder: 2. Vigência
		lineageTag: 69837717-02e5-5ecf-bde3-c58a04341fe1

	measure 'Receita a Vencer 180 Dias' = CALCULATE(SUM(fCarteira[Valor mensal]), fCarteira[Vigente] = 1, fCarteira[Dias para vencimento] >= 0, fCarteira[Dias para vencimento] <= 180)
		formatString: "\R$ #,0;-\R$ #,0"
		displayFolder: 2. Vigência
		lineageTag: cb01b38d-4dfb-56a2-9d7c-815516a9f810

	measure 'Receita a Vencer 180 Dias %' = DIVIDE([Receita a Vencer 180 Dias], [Receita Mensal Contratada])
		formatString: "0.00%"
		displayFolder: 2. Vigência
		lineageTag: cdc53797-de94-5d96-9221-af3942c86ebf

	measure 'Renovações Decisão Imediata' = CALCULATE(COUNTROWS(fRenovacoes), fRenovacoes[Decisão imediata] = "Sim") + 0
		formatString: "#,0"
		displayFolder: 3. Renovação
		lineageTag: 1b831e42-64a6-5bb6-b10e-7ddb69fd9b23

	measure 'Valor em Renovações Abertas' = CALCULATE(SUM(fRenovacoes[Valor mensal atual]), fRenovacoes[Aberta] = 1)
		formatString: "\R$ #,0;-\R$ #,0"
		displayFolder: 3. Renovação
		lineageTag: 6166ab78-182d-52a3-93e5-10c8db4a1be4

	measure Renovados = CALCULATE(COUNTROWS(fRenovacoes), fRenovacoes[Status renovação] = "Renovado") + 0
		formatString: "#,0"
		displayFolder: 3. Renovação
		lineageTag: 93626075-8eb4-5c4d-b949-4ebbe00005ea

	measure 'Não Renovados' = CALCULATE(COUNTROWS(fRenovacoes), fRenovacoes[Status renovação] = "Não renovado") + 0
		formatString: "#,0"
		displayFolder: 3. Renovação
		lineageTag: b106e7d8-f8bc-56d9-835d-bab84d9925d1

	measure 'Taxa de Renovação' = DIVIDE([Renovados], [Renovados] + [Não Renovados], 0)
		formatString: "0.00%"
		displayFolder: 3. Renovação
		lineageTag: e9331a5b-78d3-59eb-9b1a-53fa269d827e

	measure 'Valor Retido por Renovação' = CALCULATE(SUM(fRenovacoes[Valor renovado]), fRenovacoes[Status renovação] = "Renovado")
		formatString: "\R$ #,0;-\R$ #,0"
		displayFolder: 3. Renovação
		lineageTag: 7407633d-d16f-5931-a15b-f3bae1262a1a

	measure 'Valor Perdido sem Renovação' = CALCULATE(SUM(fRenovacoes[Valor mensal atual]), fRenovacoes[Status renovação] = "Não renovado")
		formatString: "\R$ #,0;-\R$ #,0"
		displayFolder: 3. Renovação
		lineageTag: 6963bde9-ba91-57d5-a522-3f2e8f09d997

	measure 'Antecedência Média' = AVERAGE(fRenovacoes[Antecedência decisão dias])
		formatString: "0.0"
		displayFolder: 3. Renovação
		lineageTag: 1ebc3db2-932e-58b2-9f0e-47e88200db07

	measure 'Eventos Abertos' = SUM(fEventos[Aberto]) + 0
		formatString: "#,0"
		displayFolder: 4. Reajustes
		lineageTag: ec9668fe-49a2-5d20-b4fe-d968a7a76680

	measure 'Acréscimo em Análise' = CALCULATE(SUM(fEventos[Acréscimo mensal]), fEventos[Status evento] = "Em análise")
		formatString: "\R$ #,0;-\R$ #,0"
		displayFolder: 4. Reajustes
		lineageTag: b5b00345-2e5d-5076-a743-a4ce92bdc371

	measure 'Acréscimo Eventos Abertos' = CALCULATE(SUM(fEventos[Acréscimo mensal]), fEventos[Aberto] = 1)
		formatString: "\R$ #,0;-\R$ #,0"
		displayFolder: 4. Reajustes
		lineageTag: c3a37571-ddd8-5f36-88af-e1851fea2f10

	/// Estimativa sujeita às cláusulas contratuais.
	measure 'Retroativo Estimado' = SUM(fEventos[Retroativo estimado])
		formatString: "\R$ #,0;-\R$ #,0"
		displayFolder: 4. Reajustes
		lineageTag: 298f242a-ffdb-545c-b18d-d4fb1781cf1d

	measure 'Data-base sem Evento' = CALCULATE(COUNTROWS(fCarteira), fCarteira[Vigente] = 1, fCarteira[Situação reajuste] = "Sem evento registrado") + 0
		formatString: "#,0"
		displayFolder: 4. Reajustes
		lineageTag: 0b78fda8-00eb-5af5-a157-090733bbf02e

	measure 'Obrigações Vencidas' = CALCULATE(COUNTROWS(fObrigacoes), fObrigacoes[Situação prazo] = "Vencida") + 0
		formatString: "#,0"
		displayFolder: 5. Operação e Riscos
		lineageTag: 36e133a4-61ef-5636-b190-27dd0af548aa

	measure 'Glosas 12 Meses' = CALCULATE(SUM(fOcorrencias[Valor glosa]), FILTER(ALL(fOcorrencias[Data]), fOcorrencias[Data] >= EDATE([Data Referência], -12)))
		formatString: "\R$ #,0.00;-\R$ #,0.00"
		displayFolder: 5. Operação e Riscos
		lineageTag: 7395c11f-ffb3-50df-abfd-502e20a17b3f

	measure 'Contrato com Mais Ocorrências' = MAXX(TOPN(1, FILTER(fCarteira, fCarteira[Ocorrências 12m] > 0), fCarteira[Ocorrências 12m], DESC), fCarteira[ID contrato])
		displayFolder: 5. Operação e Riscos
		lineageTag: e377cfa7-70ac-5ab4-8bbe-a595a2ad9290

	measure 'Ocorrências Registradas' = CALCULATE(COUNTROWS(fOcorrencias), fOcorrencias[Tipo registro] = "Ocorrência") + 0
		formatString: "#,0"
		displayFolder: 5. Operação e Riscos
		lineageTag: 8ba55cb3-8653-5380-819c-2761a78b5347

	measure 'Registros Abertos' = SUM(fOcorrencias[Aberta]) + 0
		formatString: "#,0"
		displayFolder: 5. Operação e Riscos
		lineageTag: 29bc4dd0-323d-555f-b380-a49c3767b8d2

	measure 'Riscos e Ocorrências' = COUNTROWS(fOcorrencias)
		formatString: "#,0"
		displayFolder: 5. Operação e Riscos
		lineageTag: 73b2dc2a-a206-5fda-b002-2a9e8e4549cc

	measure 'Registros Graves Abertos' = CALCULATE(COUNTROWS(fOcorrencias), fOcorrencias[Aberta] = 1, fOcorrencias[Severidade] IN {"Crítica", "Alta"}) + 0
		formatString: "#,0"
		displayFolder: 5. Operação e Riscos
		lineageTag: 8ffb46b9-326d-5818-a267-df551def4891

	measure 'Oportunidades Abertas' = SUM(fOportunidades[Aberta]) + 0
