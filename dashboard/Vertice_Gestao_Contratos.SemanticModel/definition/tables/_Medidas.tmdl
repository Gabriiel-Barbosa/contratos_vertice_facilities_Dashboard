		displayFolder: 7. Perdas
		lineageTag: 62728753-1bbf-5ce0-9059-a8007e8492da

	measure 'Receita Perdida 12 Meses' = CALCULATE(SUM(fEncerrados[Valor mensal perdido]), fEncerrados[Perda 12m] = 1)
