		displayFolder: 6. Comercial
		lineageTag: 626777ec-380f-5c2f-a136-c520b96c2017

	measure 'Propostas Abaixo da Margem' = CALCULATE(COUNTROWS(fOportunidades), fOportunidades[Aberta] = 1, fOportunidades[Sinal margem] = "Abaixo do limite") + 0
		formatString: "#,0"
		displayFolder: 6. Comercial
		lineageTag: 004c8f76-6932-5a3c-bd1d-d786eef4f9bd

	measure 'Oportunidades Ganhas' = CALCULATE(COUNTROWS(fOportunidades), fOportunidades[Resultado] = "Ganha") + 0
		formatString: "#,0"
		displayFolder: 6. Comercial
		lineageTag: fbdf0c70-3c31-5a30-b8f5-b823596d4154

	measure 'Oportunidades Concluídas' = CALCULATE(COUNTROWS(fOportunidades), fOportunidades[Resultado] IN {"Ganha", "Perdida", "Desclassificada"}) + 0
		formatString: "#,0"
		displayFolder: 6. Comercial
		lineageTag: 0c902225-0e36-5ed0-9026-3b620f069fac

	measure 'Taxa de Conversão' = DIVIDE([Oportunidades Ganhas], [Oportunidades Concluídas], 0)
		formatString: "0.00%"
		displayFolder: 6. Comercial
		lineageTag: 62b64924-5a05-58d5-9c66-3b60291cd3b6

	measure 'Valor Propostas Perdidas' = CALCULATE(SUM(fOportunidades[Valor anual estimado]), fOportunidades[Resultado] = "Perdida")
		formatString: "\R$ #,0;-\R$ #,0"
		displayFolder: 6. Comercial
		lineageTag: 0497a147-44fd-5e9f-974c-fb5939025bea

	measure 'Propostas por Motivo' = CALCULATE(COUNTROWS(fOportunidades), KEEPFILTERS(fOportunidades[Motivo perda] <> ""))
